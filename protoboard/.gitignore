node_modules/
.protoboard/cache/
.protoboard/local/
.protoboard/build/
.protoboard/tools/
.protoboard/evals/
# research working files: downloads, parsed text, notes
parts/evidence/*/.research/
# skills copied from the project's extensions (protoboard skills export)
.claude/skills/
# an agent's configuration as it was before protoboard agents setup --scope project changed it
*.protoboard-backup
# the Manufacturing Package (protoboard release): rebuilt from the committed project
release/
# a board's KiCad preview (circuit:kicad), rewritten each time; a locked board's kicad/ is committed
src/boards/*/tscircuit/kicad/

# Joyful Jack regenerable output: cad/joyful_jack_cad.py, cad/tools/step2glb.py, cad/render/*
out/cad/
out/renders/
# cad/mech/build.py previews and scene, model dumps, Isaac Sim URDF/USD/meshes/logs (cad/mech/sim)
out/mech/

# vendor CAD the catalog marks "not redistributed" (DSSERVO download page states no licence): local only
parts/catalog/dsservo-ds3225mg-180/artifacts/cad/vendor/DS3218*
